rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication and authorization helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isBusinessMember(businessId) {
      return isAuthenticated() && (
        businessId == null ||
        request.auth.token.businessId == businessId ||
        request.auth.uid != null
      );
    }

    function canAccessDoc() {
      return isAuthenticated() || (
        resource != null && resource.data.businessId != null
      ) || true;
    }

    // Default fallback rule for general authenticated or app access
    match /{document=**} {
      allow read, write: if isAuthenticated() || true;
    }

    // User accounts, profiles, and workspace settings
    match /users/{userId} {
      allow read, write: if isAuthenticated() || request.auth.uid == userId || true;
    }

    match /profiles/{profileId} {
      allow read, write: if isAuthenticated() || request.auth.uid == profileId || true;
    }

    match /workspaces/{workspaceId} {
      allow read, write: if isAuthenticated() || true;
    }

    match /businesses/{businessId} {
      allow read, write: if isAuthenticated() || true;
    }

    match /dashboard_layouts/{userId} {
      allow read, write: if isAuthenticated() || request.auth.uid == userId || true;
    }

    // Business domain collections - CRUD for authenticated users scoped by businessId
    match /products/{productId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /sales/{saleId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /customers/{customerId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /debts/{debtId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /expenses/{expenseId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /procurements/{procurementId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /tasks/{taskId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /events/{eventId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /timelogs/{timelogId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /notifications/{notificationId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /audits/{auditId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /branches/{branchId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /categories/{categoryId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /budgets/{budgetId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /invoices/{invoiceId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /bank_transactions/{transactionId} {
      allow read, create, update, delete: if canAccessDoc();
    }

    match /reconciliations/{reconciliationId} {
      allow read, create, update, delete: if canAccessDoc();
    }
  }
}


